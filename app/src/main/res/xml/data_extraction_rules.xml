<?xml version="1.0" encoding="utf-8"?>
<!-- HTFU 2.14: nothing goes into Google cloud backup or device-to-device transfer.
     The app's data (WebView localStorage with workouts and progress photos, reminder
     settings) stays on the device; the in-app Backup file is the way to move it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
